# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASEPATH=http://localhost:3000
BASEPATH=

# -----------------------------------------------------------------------------
# Access control (src/middleware.ts + src/configs/accessControl.ts)
# -----------------------------------------------------------------------------
# Local-dev escape hatch: set to true to skip auth/role checks while developing.
# Leave false / unset in production so route protection is enforced.
AUTH_DISABLED=false
# Same switch for the client. The layout no longer redirects or signs in on its own, so this is
# only a mirror of AUTH_DISABLED for client code that wants to know. Keep the two in sync.
NEXT_PUBLIC_AUTH_DISABLED=${AUTH_DISABLED}

# -----------------------------------------------------------------------------
# Demo role simulator (src/libs/demo.ts, /demo, /api/demo/session)
# -----------------------------------------------------------------------------
# Lets anyone sign in as a fictional persona without ERP. Default false (off).
# WARNING: never set DEMO_MODE=true on a real production deployment. Demo sessions are
# minted for fictional personas only; no real person's data may be used with them.
DEMO_MODE=false
# Client switch for the same feature (shows the /demo entry on the public home page).
# Keep it in sync with DEMO_MODE.
NEXT_PUBLIC_DEMO_MODE=false

# -----------------------------------------------------------------------------
# Application roles for real ERP accounts (src/libs/roleResolver.ts)
# -----------------------------------------------------------------------------
# Comma-separated ERP STAFFIDs. Anyone not listed is a regular 'user'.
# If an ID appears in both lists, the university admin role wins.
ROLE_UNIVERSITY_ADMINS=
ROLE_DEPT_ADMINS=

# -----------------------------------------------------------------------------
# Logging (src/libs/logger) — daily files + Discord error alerts
# -----------------------------------------------------------------------------
LOG_ENABLED=true
# debug | info | warn | error | fatal
LOG_LEVEL=debug
# Directory for the daily files: <dir>/app-YYYY-MM-DD.log และ <dir>/error-YYYY-MM-DD.log
LOG_DIR=logs
LOG_FILE_PREFIX=app
LOG_TIMEZONE=Asia/Bangkok
# Files older than this many days are deleted automatically (0 = keep forever)
LOG_RETENTION_DAYS=30
# Mirror logs to the console as well
LOG_CONSOLE=true
# Indent the JSON in the file (easier to read by hand, harder to grep)
LOG_PRETTY=false
# Max client-side log posts accepted per IP per minute (/api/log)
LOG_CLIENT_MAX_PER_MINUTE=60

# Discord webhook — paste the URL here when you have it; nothing else needs changing.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_ENABLED=true
# Minimum level that triggers a Discord alert
DISCORD_WEBHOOK_LEVEL=error
DISCORD_WEBHOOK_USERNAME=MSU App Logger
# Optional mention for fatal alerts, e.g. <@&123456789012345678>
DISCORD_WEBHOOK_MENTION=
DISCORD_WEBHOOK_ENVIRONMENT=development
# ช่องทางที่ webhook อยู่: ตั้ง true ถ้าเป็น **forum channel** (Discord บังคับว่าทุกข้อความ
# ต้องอยู่ในโพสต์ — ระบบจะเปิดโพสต์ใหม่ตั้งชื่อตาม error และ error เดิมจะตอบกลับเข้าโพสต์เดิม)
DISCORD_WEBHOOK_FORUM=false
# ส่งทุก alert เข้าโพสต์/เธรดเดิมอันเดียว (คลิกขวาที่โพสต์ → Copy Link → เอา id ท้ายสุด)
# ตั้งค่านี้แล้วจะไม่เปิดโพสต์ใหม่เลย และใช้ได้กับ text channel ที่มีเธรดด้วย
DISCORD_WEBHOOK_THREAD_ID=
# ติด tag ให้โพสต์ที่เปิดใหม่ในฟอรั่ม (คั่นด้วยจุลภาค) — ไม่ใส่ก็ได้
DISCORD_WEBHOOK_TAG_IDS=
# Suppress duplicate alerts of the same error within this window (ms)
DISCORD_WEBHOOK_DEDUPE_MS=60000
DISCORD_WEBHOOK_MAX_PER_MINUTE=20

# -----------------------------------------------------------------------------
# MCP / chatbot (src/mcp, docs/mcp.md)
# -----------------------------------------------------------------------------
# Public URL of this system including basePath (needed behind a reverse proxy),
# e.g. https://erp.msu.ac.th/digitalplan
MCP_PUBLIC_URL=
# Exact OAuth redirect URIs allowed to register (comma-separated). Setting this REPLACES the
# default (claude.ai + claude.com callbacks) — list them again if you still want Claude.
MCP_ALLOWED_REDIRECT_URIS=
# Where clients/grants/pending actions are stored (default: data/mcp-store.json)
MCP_STORE_FILE=
# In-app AI assistant — any OpenAI-compatible endpoint (BYOK). Empty key = assistant disabled.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5
LLM_MAX_TOKENS=1024
LLM_MAX_PER_MINUTE=20

# Tour auto-play on first visit (default on). false = only the ? button.
# NEXT_PUBLIC_TOUR_AUTOSTART=false

# -----------------------------------------------------------------------------
# Manual generator (scripts/manual, docs/manual.md) — local/dev only
# -----------------------------------------------------------------------------
# Server to capture (default http://localhost:3000 + NEXT_PUBLIC_BASEPATH)
MANUAL_BASE_URL=
# Narration: edge (default, free, no key) | elevenlabs | none
MANUAL_TTS=
MANUAL_TTS_VOICE=th-TH-PremwadeeNeural
# Setting a key switches narration to ElevenLabs automatically
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Where generated manual files are written/served (default data/manual)
MANUAL_DIR=

# -----------------------------------------------------------------------------
# Notifications (src/libs/notify.ts) — each channel is off until its keys are set
# -----------------------------------------------------------------------------
# LINE Messaging API push: channel access token + recipient user/group id(s), comma-separated
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_TO=
# Email over SMTP (requires `pnpm add nodemailer`): host/from/recipients enable it
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# -----------------------------------------------------------------------------
# Audit log + file uploads (docs/audit-and-uploads.md)
# -----------------------------------------------------------------------------
# Monthly JSONL audit files (default data/audit)
AUDIT_DIR=
# Uploaded files + metadata (default data/uploads)
UPLOAD_DIR=
# Max upload size in MB (default 10). Keep the reverse proxy's body limit at or above this.
UPLOAD_MAX_MB=
